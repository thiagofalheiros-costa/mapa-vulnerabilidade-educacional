# ==========================================================
# Ambientes virtuais
# ==========================================================
.venv/
venv/
env/

# ==========================================================
# Python
# ==========================================================
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.so

# ==========================================================
# Variáveis de ambiente e credenciais
# ==========================================================
.env
.env.*
!.env.example
.streamlit/secrets.toml

# ==========================================================
# Editores e sistema operacional
# ==========================================================
.vscode/
.idea/
.DS_Store
Thumbs.db

# ==========================================================
# Jupyter
# ==========================================================
.ipynb_checkpoints/

# ==========================================================
# Logs, testes e análise estática
# ==========================================================
*.log
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# ==========================================================
# Modelos gerados
# ==========================================================
models/*.pkl
models/*.joblib

# ==========================================================
# Relatórios gerados
# ==========================================================
reports/figures/*
reports/maps/*
reports/tables/*

# Preservar a estrutura dos diretórios de relatórios
!reports/figures/.gitkeep
!reports/maps/.gitkeep
!reports/tables/.gitkeep

# ==========================================================
# Dados brutos, intermediários e externos
# ==========================================================
data/raw/*
data/interim/*
data/external/*

# Preservar a estrutura dos diretórios de dados
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/external/.gitkeep

# ==========================================================
# Dados processados
# ==========================================================
data/processed/*

# Preservar a estrutura e as bases necessárias ao dashboard
!data/processed/.gitkeep
!data/processed/municipality_base.parquet
!data/processed/municipality_vulnerability.parquet
!data/processed/municipality_geodata.parquet
